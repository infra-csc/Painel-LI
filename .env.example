# Copie para .env (desenvolvimento) ou configure nos Secrets do Replit.
# NUNCA versione o .env preenchido.

# ── Obrigatórias ──────────────────────────────────────────────────────────

# String de conexão do Postgres. O app não sobe sem ela.
DATABASE_URL=postgresql://usuario:senha@host/banco

# Segredo que assina o cookie de sessão.
# Se não for definido, o app cai num valor padrão que está versionado neste
# repositório — ou seja, público. Gere um valor novo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Segredo compartilhado com o Portal Norte. Tem duas funções:
#   1. verificar a assinatura do JWT de SSO (?portal_sso=...)
#   2. autenticar as chamadas server-to-server em /api/portal/*
#      (header: Authorization: Bearer <SSO_SECRET>)
# Se não for definido, o app usa SESSION_SECRET e, na falta dele, o padrão
# público — o que permite forjar um token de SSO com role "admin".
SSO_SECRET=

# ── Integrações ───────────────────────────────────────────────────────────

# Token que o sistema Maratona usa para consumir /api/integration/*
# (header: Authorization: Bearer <MARATONA_API_TOKEN>).
# Sem ele, essas rotas respondem 503.
MARATONA_API_TOKEN=

# ── Object Storage (Replit) ───────────────────────────────────────────────

# Diretório privado do bucket, no formato /<bucket>/<prefixo>.
PRIVATE_OBJECT_DIR=

# Caminhos públicos, separados por vírgula.
PUBLIC_OBJECT_SEARCH_PATHS=

# ── Runtime ───────────────────────────────────────────────────────────────

# Porta HTTP. No Replit já vem definida como 5000.
PORT=5000

# "production" ativa cookie Secure + SameSite=None (necessário para o iframe
# do Portal Norte) e exige que a sessão tenha vindo do SSO.
NODE_ENV=development

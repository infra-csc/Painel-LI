# Copie para .env (desenvolvimento) ou configure nos Secrets do Replit.
# NUNCA versione o .env preenchido.

# ── Obrigatórias ──────────────────────────────────────────────────────────

# String de conexão do Postgres. O app não sobe sem ela.
DATABASE_URL=postgresql://usuario:senha@host/banco

# Segredo que assina o cookie de sessão.
# Em PRODUÇÃO (NODE_ENV=production) o boot ABORTA se não estiver definido.
# Em desenvolvimento, sem ele, o app usa um valor padrão que está versionado
# neste repositório — ou seja, público — e avisa no log. Gere um valor novo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Segredo compartilhado com o Portal Norte que verifica a assinatura do JWT de
# SSO (?portal_sso=...). Em produção o boot ABORTA se não estiver definido.
# Em desenvolvimento cai em SESSION_SECRET e, na falta dele, no padrão público.
SSO_SECRET=

# Origem(ns) do Portal Norte, separadas por vírgula (ex.: https://portal.norte.com.br).
# Usada para: CSP frame-ancestors (quem pode nos abrir em iframe), allowlist do
# CSRF (Origin permitido em mutações) e validação de ?portal_return=.
# Sem ela, em produção, o iframe do portal não carrega (frame-ancestors 'self').
PORTAL_ORIGIN=

# Token das chamadas server-to-server do Portal Norte em /api/portal/*
# (header: Authorization: Bearer <PORTAL_API_TOKEN>). Segredo PRÓPRIO, separado
# do que assina o JWT. Enquanto não for definido, o app aceita SSO_SECRET nesse
# header e registra um aviso de depreciação no boot.
PORTAL_API_TOKEN=

# ── Integrações ───────────────────────────────────────────────────────────

# Token que o sistema Maratona usa para consumir /api/integration/*
# (header: Authorization: Bearer <MARATONA_API_TOKEN>).
# Sem ele, essas rotas respondem 503.
MARATONA_API_TOKEN=

# ── Object Storage (Replit) ───────────────────────────────────────────────

# Diretório privado do bucket, no formato /<bucket>/<prefixo>.
PRIVATE_OBJECT_DIR=

# Caminhos públicos, separados por vírgula.
PUBLIC_OBJECT_SEARCH_PATHS=

# ── Runtime ───────────────────────────────────────────────────────────────

# Porta HTTP. No Replit já vem definida como 5000.
PORT=5000

# "production" ativa cookie Secure + SameSite=None (necessário para o iframe
# do Portal Norte), HSTS, exige que TODA sessão da API tenha vindo do SSO e
# desliga o login por senha (POST /api/auth/login responde 403).
NODE_ENV=development
